{
  "name": "riverwaterlevels",
  "compatibility_date": "2026-10-01",
  // edge live layer, fetch-on-open: gauge pages and /live/<site>.json run through worker/index.js; every other file is served straight
  // from dist/. No cron and no KV (owner 2026-10-26: nothing pulled on a timer, nothing stored). Free plan limits are per ACCOUNT and
  // shared with asmrregistry: 5 cron triggers, 100,000 worker requests/day, 10 ms CPU per request.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/river/*", "/live/*"]
  },
  "routes": [
    { "pattern": "riverwaterlevels.com", "custom_domain": true }
  ]
}
