{
  "name": "riverwaterlevels",
  "compatibility_date": "2026-10-01",
  // edge live layer (plan 2026-10-26): a */3 cron asks USGS only what changed and stores ONE copy in KV; gauge pages and
  // /live/<site>.json read it (no USGS call on any page view). Every other file is served straight from dist/.
  // Free plan limits are per ACCOUNT, shared with asmrregistry: 5 crons (asmrregistry 2 + asmrregistry-cron 1 + this 1 = 4),
  // 1,000 KV writes/day (*/3 = at most 480), 100,000 worker requests/day, 10 ms CPU, 20,000 files. Paid ($5/mo) before ~1,500 gauges.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/river/*", "/live/*"]
  },
  "kv_namespaces": [
    { "binding": "LIVE", "id": "8f6e5bd9236e4d508dfaaf2b5e6e52e5" }
  ],
  "triggers": { "crons": ["*/3 * * * *"] },
  // Workers Logs (audit 2026-11-10 #41): poll, build-trigger and fallback errors are console.error lines in the dashboard (Workers > riverwaterlevels > Logs).
  // Free plan: 200,000 log events a day, 3 days kept. Every request is one event and the free plan stops at 100,000 requests a day, plus 480 cron runs,
  // so sampling every invocation fits; past the daily cap Cloudflare only drops logs, never a page. ponytail: on Workers Paid lower the rate when requests near its 20 million included log events a month.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [
    { "pattern": "riverwaterlevels.com", "custom_domain": true }
  ]
}
